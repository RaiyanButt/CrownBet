{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build sfml2",
        "type": "shell",
        "command": "clang++",
        "args": [
          "main.cpp",
          "rng.cpp",
          "button.cpp",
          "slots_game.cpp",
          "slots_render.cpp",
          "blackjack_game.cpp",
          "blackjack_screen.cpp",
          "crash_game.cpp",
          "crash_screen.cpp",
          "-o",
          "app",
          "-std=c++17",
          "-I/opt/homebrew/opt/sfml@2/include",
          "-L/opt/homebrew/opt/sfml@2/lib",
          "-lsfml-graphics",
          "-lsfml-window",
          "-lsfml-system"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": ["$gcc"]
      }
    ]
  }